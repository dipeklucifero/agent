# =========================================================================
# Hermes Agent - copy to .env and fill in. NEVER commit .env.
# =========================================================================

# --- LLM (OpenRouter) ---------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# Recommended: NousResearch/Hermes-4-70B. Fallback: Hermes-3-Llama-3.1-8B.
HERMES_MODEL=nousresearch/hermes-4-70b
HERMES_FALLBACK_MODEL=nousresearch/hermes-3-llama-3.1-8b

# --- Telegram -----------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-...
# Your personal Telegram user id. Agent will ONLY accept commands from this id.
TELEGRAM_OWNER_ID=123456789
# Optional: channel id where the agent posts an audit log of every tool call.
# Leave blank to disable.
TELEGRAM_AUDIT_CHAT_ID=

# --- Telethon (userbot for group-joins, optional) ----------------------
# Obtain from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Path to session file (lives in /app/data inside the container).
TELETHON_SESSION=/app/data/userbot.session

# --- Keystore master password ------------------------------------------
# Used to derive the AES key that encrypts private keys at rest.
# If you lose this, you lose your burner wallets. Store in password manager.
KEYSTORE_PASSWORD=change-me-to-something-long-and-random

# --- X (Twitter) burner account ----------------------------------------
X_USERNAME=
X_EMAIL=
X_PASSWORD=
# Optional cookie file (preferred - avoids password login).
X_COOKIES_PATH=/app/data/x_cookies.json

# --- Discord bot token (for messaging). Self-bots are banned, so this is
# only useful for your own guilds where the bot is invited. For joining
# arbitrary guilds, use invite links in the browser.
DISCORD_BOT_TOKEN=

# --- Safety caps --------------------------------------------------------
MAX_TX_USD=50
REQUIRE_MAINNET_CONFIRM=true
